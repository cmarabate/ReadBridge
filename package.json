{
  "name": "readbridge",
  "version": "0.1.0",
  "description": "Universal Windows AI Read Aloud with synchronized text highlighting across applications.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "verify:build": "yarn build && dotnet build ReadBridge.slnx",
    "verify:ts": "yarn typecheck",
    "verify:lint": "yarn lint",
    "evidence:lifecycle": "node scripts/run_lifecycle_runtime_checks.js --out docs/evidence/companion-lifecycle-runtime.json",
    "inspect:live": "dotnet run --project native/ReadBridge.Companion -- inspect",
    "matrix:scan": "dotnet run --project native/ReadBridge.Companion -- matrix-scan",
    "highlight:test": "dotnet run --project native/ReadBridge.Companion -- highlight-test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
